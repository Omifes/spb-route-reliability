# Скопируйте файл в .env и при необходимости измените значения:
#   cp .env.example .env            (Linux/macOS)
#   Copy-Item .env.example .env     (PowerShell)
# Файл используется Docker Compose и импортируется Spring Boot.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=spb_transit
POSTGRES_USER=spb_app
POSTGRES_PASSWORD=spb_app
POSTGRES_PORT=5432

# --- pgAdmin (необязательно, профиль tools) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=spb_admin
PGADMIN_PORT=5050

# --- Spring Boot ---
DB_URL=jdbc:postgresql://localhost:5432/spb_transit
DB_USER=spb_app
DB_PASSWORD=spb_app
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
SERVER_PORT=8080

# --- Демонстрационный пользователь (Basic Auth) ---
# В production обязательно установите APP_DEMO_USER_ENABLED=false.
APP_DEMO_USER_ENABLED=true
APP_DEMO_USER_EMAIL=demo@spb.local
APP_DEMO_USER_PASSWORD=demo

# --- Окна актуальности данных для /api/trips/{id}/status ---
STATUS_CURRENT_WINDOW=PT5M
STATUS_STALE_WINDOW=PT60M

# --- Логирование (STDOUT) ---
# Уровни можно менять без пересборки: DEBUG удобен для отладки статуса и надёжности.
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# --- CORS для фронтенда (origin через запятую) ---
# Для локальной разработки достаточно значений по умолчанию.
# В production укажите точный адрес фронтенда, например https://transit.example.ru
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://localhost:3000,http://localhost:5173

APP_AGGREGATOR_ENABLED=true
APP_AGGREGATOR_MAX_TASKS=2
APP_AGGREGATOR_INTERVAL_SECONDS=10
